# ------------------------------------------------------------------
# Copy this file to ".env.local" for local dev, and add the same keys
# to your Vercel project's Environment Variables for production.
# NEVER commit the filled-in .env.local — it is gitignored.
# ------------------------------------------------------------------

# --- Smartsheet ---
# Personal access token: Smartsheet -> Account -> Personal Settings -> API Access
SMARTSHEET_API_TOKEN=your-smartsheet-access-token
# The numeric sheet ID (Smartsheet -> right-click the sheet -> Properties)
SMARTSHEET_SHEET_ID=your-sheet-id

# --- Supabase ---
# Project URL, e.g. https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# anon/public key — safe to expose to the browser (read-only via RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role key — SERVER ONLY. Used by the sync route to write rows.
# Never prefix this with NEXT_PUBLIC_ and never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cron protection ---
# Any long random string. Vercel Cron sends this automatically as a Bearer
# token when you set it here; blocks strangers from triggering /api/sync.
CRON_SECRET=generate-a-long-random-string
